generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// USER & STAFF MANAGEMENT
// -------------------------------------------------------------
model Staff {
  id        String   @id @default(uuid())
  role      String // e.g., 'registrar', 'admissions', 'finance'
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// ADMISSIONS & STUDENT LIFECYCLE
// -------------------------------------------------------------
model Application {
  id                String   @id @default(uuid())
  applicationNumber String   @unique
  applicantName     String
  email             String
  phone             String
  programApplied    String
  career            String // 'UG', 'PG', etc.
  department        String
  appliedDate       DateTime @default(now())
  status            String // 'Under Review', 'Enrolled', 'Rejected'
  highSchoolGPA     Float?

  // Potential ID assignments upon enrollment
  assignedUid   String?
  assignedRegNo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                 String @id @default(uuid())
  internalSeq        Int    @unique @default(autoincrement())
  studentUid         String @unique // e.g., 'BMIXXX'
  registrationNumber String @unique // e.g., 'BMI/UG-CS/226/001'
  studentNumber      String @unique

  // Demographics
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  dateOfBirth DateTime
  nationalId  String   @unique
  gender      String
  nationality String

  // Academics
  career          String
  program         String
  department      String
  cohortYear      Int
  currentSemester Int    @default(1)
  academicStatus  String @default("Active")

  // Metrics
  gpa             Float @default(0.0)
  cgpa            Float @default(0.0)
  creditsEarned   Int   @default(0)
  creditsRequired Int   @default(120)

  // Holds & Advising
  financialHold    Boolean @default(false)
  academicHold     Boolean @default(false)
  advisorName      String?
  advisorEmail     String?
  // Guardian Details
  guardianName     String?
  guardianRelation String?
  guardianPhone    String?
  guardianEmail    String?

  // Profile
  avatarUrl String?

  // Relations
  invoices    FeeInvoice[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// ACADEMICS & ENROLLMENT
// -------------------------------------------------------------
model Course {
  id         String  @id @default(uuid())
  code       String  @unique // e.g., 'CS101'
  title      String
  credits    Int
  department String
  level      Int     @default(100)
  capacity   Int     @default(50)
  instructor String?

  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Join table for many-to-many between Student and Course
model Enrollment {
  id        String  @id @default(uuid())
  studentId String
  courseId  String
  term      String // e.g., 'Fall 2026'
  status    String  @default("Enrolled") // 'Enrolled', 'Completed', 'Dropped'
  grade     String? // 'A', 'B+', etc.

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId, term]) // A student can't enroll in the same course twice in a term
}

// -------------------------------------------------------------
// FINANCE & BILLING
// -------------------------------------------------------------
model FeeInvoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  studentId     String
  term          String
  dueDate       DateTime
  issueDate     DateTime @default(now())

  totalAmount         Float
  amountPaid          Float  @default(0)
  scholarshipDiscount Float  @default(0)
  status              String @default("Unpaid") // 'Unpaid', 'Partial', 'Paid'

  // Storing items as JSON for simplicity, or we could create an InvoiceItem table
  items Json

  student Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// SYSTEM & COMPLIANCE
// -------------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  performedBy String
  role        String
  action      String
  details     String
  ipAddress   String?
  severity    String   @default("Info") // 'Info', 'Warning', 'Critical'
}
