# Local development secrets — NEVER commit this file to git!
# ─────────────────────────────────────────────────────────────
# HOW TO FILL THESE IN:
#
# 1. DATABASE_URL through CAMPUS_DATABASE_URL
#    → Go to neon.tech → your project → Dashboard → "Connect"
#    → Copy the "Connection String" for each project
#    → Format: postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require
#
# 2. NEON_AUTH_JWKS_URL
#    → Go to neon.tech → your core-db project → "Auth" tab
#    → Enable Neon Auth. Your JWKS URL will be displayed as:
#      https://<your-project-id>.neon.tech/.well-known/jwks.json
#    → Paste that full URL below
# ─────────────────────────────────────────────────────────────

# Core academic database (students, courses, grades, finance)
DATABASE_URL=postgresql://user:password@ep-core-db.us-east-2.aws.neon.tech/core-db?sslmode=require

# Auxiliary databases — each is a separate Neon free-tier project
HR_DATABASE_URL=postgresql://user:password@ep-hr-db.us-east-2.aws.neon.tech/hr-db?sslmode=require
LIBRARY_DATABASE_URL=postgresql://user:password@ep-library-db.us-east-2.aws.neon.tech/library-db?sslmode=require
ALUMNI_DATABASE_URL=postgresql://user:password@ep-alumni-db.us-east-2.aws.neon.tech/alumni-db?sslmode=require
CAMPUS_DATABASE_URL=postgresql://user:password@ep-campus-db.us-east-2.aws.neon.tech/campus-db?sslmode=require

# Neon Auth JWKS — public key endpoint for JWT signature verification
# Get this from: neon.tech → core-db project → Auth tab → enable Neon Auth
NEON_AUTH_JWKS_URL=https://your-project-id.neon.tech/.well-known/jwks.json
